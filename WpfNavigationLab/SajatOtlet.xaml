<Page x:Class="WpfNavigationLab.SajatOtlet"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfNavigationLab"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="SajatOtlet"
      Background="#F8FAFC">


    <Grid>
        
        <Grid Margin="30">
            
            <StackPanel>


                <TextBlock
                        Text="Miért jobb a page"
                        FontSize="26"
                        FontWeight="Bold"
                        Foreground="#1E293B"
                        HorizontalAlignment="Center"/>

                <TextBlock
                        FontSize="14"
                        Text="-Modernebb kinézet"
                        Margin="0,20,0,5"/>

                <TextBlock
                        FontSize="14"
                        Text="-Könnyebben feldolgozható a felhasználó számára"
                        Margin="0,0,0,5"/>

                <TextBlock
                        FontSize="14"
                        Text="-A menüt nem kell külön belerakni a windowokba"
                        Margin="0,0,0,5"/>

                <TextBlock
                        x:Name="TextKiiras"
                        FontSize="26"
                        FontWeight="Bold"
                        Margin="0,50,0,0"
                        HorizontalAlignment="Center"/>



                <StackPanel Orientation="Horizontal" Margin="0,50,0,20">
                    <Button
                        x:Name ="ButtonNemErtEgyet"
                        Content="Nem értek egyet"
                        Height="40"
                        Width="300"
                        HorizontalAlignment="Left"
                        Click="NemErtEgyet"/>
                    
                    <Button
                        x:Name ="ButtonEgyetert"
                        Content="Egyetértek"
                        Height="40"
                        Width="300"
                        HorizontalAlignment="Right"
                        Click="Egyetert"/>


                </StackPanel>

                <Button Content="Vissza"
                    Height="45"
                    Click="BackClick"/>


            </StackPanel>
            
        </Grid>
        
    </Grid>
</Page>
