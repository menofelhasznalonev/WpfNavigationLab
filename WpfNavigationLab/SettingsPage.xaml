<Page x:Class="WpfNavigationLab.SettingsPage"

xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

Background="#F8FAFC">


    <Grid Margin="30">


        <StackPanel>


            <TextBlock x:Name="TextBeallitasok"
                    Text="Beállítások"
                    FontSize="26"
                    FontWeight="Bold"
                    Foreground="#1E293B"
                    HorizontalAlignment="Center"/>


            <CheckBox x:Name="CheckDarkMode"
                    Content="Sötét mód"
                      Margin="0,0,0,10"
                      Checked="SotetMod"
                      Unchecked="SotetMod"/>


            <Button Content="Vissza"
                    Height="45"
                    Click="BackClick"/>


        </StackPanel>


    </Grid>


</Page>