<Window x:Class="WpfNavigationLab.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfNavigationLab"
        mc:Ignorable="d"
        Title="HelpWindow" Height="240" Width="300">
    <Grid Margin="30">


        <StackPanel>


            <TextBlock Text="Segítség"
                    FontSize="26"
                    FontWeight="Bold"
                    Foreground="#1E293B"
                    HorizontalAlignment="Center"/>


            <TextBlock Text="Még nincs segítség"
                    Margin="0,10,0,25"/>



            <Button Content="Ablak bezárása"
                    Height="45"
                    Click="Close_Click"
                    Width="200"/>


        </StackPanel>


    </Grid>


</Window>
